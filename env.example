# Database is injected automatically on deploy (Neon).
# Leave unset in local/preview — the app uses an embedded Postgres fallback.
# DATABASE_URL=

# Optional. When set, /api/cron/sync requires Authorization: Bearer <secret>
# or the Vercel Cron header.
CRON_SECRET=

# Optional. Raises GitHub API rate limits for catalog ingest. Public raw JSON
# works without this.
GITHUB_TOKEN=

# Optional comma-separated HTTPS JSON catalogs with the same shape as
# nschmeller/clash-bases bases.json ({ "bases": [ { id, name, town_hall, type, link, image, ... } ] }).
EXTRA_CATALOG_URLS=

# Optional comma-separated HTTPS RSS/Atom feeds that contain official
# link.clashofclans.com OpenLayout URLs.
LAYOUT_RSS_FEEDS=
